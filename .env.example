# ─── Environment Variables ────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Vite exposes variables prefixed with VITE_ to the client.

# Your E-Comm API base URL (from the assignment API docs)
# Example using the Platzi Fake Store API:
VITE_API_BASE_URL=https://api.escuelajs.co/api/v1

# If your API requires an auth token (e.g. for /orders endpoints):
# VITE_API_TOKEN=your_token_here
